# GCP Configuration
# 로컬 개발 시 인증은 'gcloud auth application-default login' 권장
GCP_PROJECT=your-project-id
GCP_LOCATION=asia-northeast3
GCS_BUCKET_NAME=your-bucket-name

# Supabase Configuration (Database)
# Cloud Run Jobs 배포 시에는 Secret Manager 사용 권장
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
# Postgres Direct Connection (if needed for SQLAlchemy/local)
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres

# Logging
LOG_LEVEL=INFO

# Phase 1: Ingest Settings
INGEST_BATCH_PAGES=20
EMBED_BATCH_SIZE=8

# Phase 3: Retrieval Settings
PHASE3_MAX_WORKERS=1

# Compliance / Guardrails
# If true, original uploaded assets (pdf/audio) are deleted after successful processing.
DELETE_SOURCE_ASSETS_ON_SUCCESS=false
PHASE4_VERBATIM_WINDOW=80
PHASE4_MAX_TITLE_LEN=60
PHASE4_MAX_WHY_LEN=260
PHASE4_MAX_AUDIO_REFS=5
PHASE4_MAX_CITATIONS=5
PHASE4_STRICT_SCHEMA=true

# Retention / Purge (run via scheduled script)
RETENTION_DRY_RUN=true
RETENTION_SESSION_DAYS=30
RETENTION_SOURCE_DAYS=30
RETENTION_REPORT_DAYS=30
